{
  "name": "github-contribution-bomber",
  "version": "1.0.0",
  "description": "Bomberman-style auto-play animation that blows up your GitHub contribution graph, rendered as a self-contained animated SVG for your profile README.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "github-bomber": "dist/cli.js"
  },
  "scripts": {
    "generate": "tsx src/bin.ts",
    "generate:sample": "tsx src/bin.ts --source sample --output examples/sample.svg --output \"examples/sample-dark.svg?theme=dark\"",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "tsx scripts/preview.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.25.12",
    "gifenc": "^1.0.3",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BangJeongHyeok/github-grass-bomberman.git"
  },
  "keywords": [
    "github",
    "contributions",
    "readme",
    "svg",
    "animation",
    "bomberman",
    "github-actions"
  ]
}
